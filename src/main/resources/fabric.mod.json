{
  "schemaVersion": 1,
  "id": "wesort",
  "version": "${version}",
  "name": "WeSort",
  "description": "A Meteor Client addon for shared stash sorting, shulkers, kits and orders. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
  "authors": [
    "Qwertze"
  ],
  "contact": {
    "sources": "https://github.com/Crispy-Monke-eSports/WeSort"
  },
  "license": "GPL-3.0",
  "icon": "assets/wesort/icon.png",
  "environment": "client",
  "mixins": [
    "wesort.mixins.json"
  ],
  "entrypoints": {
    "meteor": [
      "com.porter.wesort.WeSortAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${java_version}",
    "minecraft": [
      "${mc_version}"
    ],
    "meteor-client": "*"
  },
  "suggests": {
    "baritone-meteor": "*"
  }
}
